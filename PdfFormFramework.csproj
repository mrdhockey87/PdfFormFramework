<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst;net10.0-windows10.0.19041.0</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
	  <!-- Generate a C# file with version information -->
	  <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
	  <!-- Version information -->
	  <!-- Define version components individually -->
	  <VersionMajor>8</VersionMajor>
	  <VersionMinor>4</VersionMinor>
	  <VersionBuild>11</VersionBuild>
	  <!-- Combine into a single version string -->
	  <VersionPrefix>$(VersionMajor).$(VersionMinor).$(VersionBuild)</VersionPrefix>

	  <!-- All version properties reference the same value -->
	  <Version>$(VersionPrefix)</Version>
	  <AssemblyVersion>$(VersionPrefix)</AssemblyVersion>
	  <FileVersion>$(VersionPrefix)</FileVersion>
	  <InformationalVersion>$(VersionPrefix)</InformationalVersion>
	  <PackageVersion>$(VersionPrefix)</PackageVersion>
  </PropertyGroup>

	<!-- Windows-only: enable WinForms so System.Windows.Forms is available -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
		<UseWindowsForms>true</UseWindowsForms>
		<!-- Optional: quiet platform analyzer warnings for Windows-only APIs -->
		<NoWarn>$(NoWarn);CA1416</NoWarn>
	</PropertyGroup>
	
  <ItemGroup>
    <None Remove="Resources\Fonts\CourierPrime-Bold.ttf" />
    <None Remove="Resources\Fonts\CourierPrime-BoldItalic.ttf" />
    <None Remove="Resources\Fonts\CourierPrime-Italic.ttf" />
    <None Remove="Resources\Fonts\CourierPrime-Regular.ttf" />
  </ItemGroup>

  <ItemGroup>
    <MauiFont Include="Resources\Fonts\CourierPrime-Bold.ttf" />
    <MauiFont Include="Resources\Fonts\CourierPrime-BoldItalic.ttf" />
    <MauiFont Include="Resources\Fonts\CourierPrime-Italic.ttf" />
    <MauiFont Include="Resources\Fonts\CourierPrime-Regular.ttf" />
  </ItemGroup>

  <ItemGroup>
    <MauiImage Include="Resources\Images\frameworkredbusyios.gif" />
    <MauiImage Include="Resources\Images\frameworkredbusyother.gif" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
	<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.10" />
	<PackageReference Include="CommunityToolkit.Maui" Version="13.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="PDFsharp" Version="6.2.3" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="3.119.1" />
    <PackageReference Include="Vitvov.Maui.PDFView" Version="1.6.0" />
    <!-- System.Drawing.Common for image handling on Windows -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <MauiXaml Update="Controls\ProgressBarOverlay.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  </ItemGroup>

</Project>